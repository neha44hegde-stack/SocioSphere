@{
    ViewData["Title"] = "My Flat";
    Layout = "_ResidentLayout";
    var p = Model as SocioSphere.Core.Entities.ResidentProfile;
    var vehicles = ViewBag.Vehicles as List<SocioSphere.Core.Entities.Vehicle> ?? new();
    var parking = ViewBag.ParkingSlots as List<SocioSphere.Core.Entities.ParkingSlot> ?? new();
    var cores = ViewBag.CoResidents as List<SocioSphere.Core.Entities.ResidentProfile> ?? new();
    var bills = ViewBag.Bills as List<SocioSphere.Core.Entities.MaintenanceBill> ?? new();
}

<h1 class="page-title">My Flat</h1>

@if (p == null) {
  <div class="card-ss">
    <div class="card-ss-body empty-state">
      <div class="icon-lg">🏠</div>
      <h5>No flat linked</h5>
      <p>Your account is not linked to a flat yet. Please contact the society admin.</p>
    </div>
  </div>
} else {

  <div class="welcome-banner">
    <div>
      <h2>Flat @p.Flat.FlatNumber</h2>
      <p>Building @p.Flat.Building.Name · Floor @p.Flat.Floor · @p.Flat.FlatType · @p.Flat.Area sqft</p>
    </div>
    <div class="avatar">🏠</div>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <span class="icon">🏢</span>
      <div class="label">Building</div>
      <div class="value">@p.Flat.Building.Name</div>
      <div class="meta">Floor @p.Flat.Floor</div>
    </div>
    <div class="stat-card">
      <span class="icon">📐</span>
      <div class="label">Area</div>
      <div class="value">@p.Flat.Area</div>
      <div class="meta">square feet</div>
    </div>
    <div class="stat-card accent">
      <span class="icon">🏷️</span>
      <div class="label">Flat Type</div>
      <div class="value">@p.Flat.FlatType</div>
      <div class="meta">@p.Flat.Status</div>
    </div>
    <div class="stat-card info">
      <span class="icon">👤</span>
      <div class="label">My Relationship</div>
      <div class="value" style="font-size:1.1rem;">@p.Relationship</div>
      <div class="meta">@(p.IsPrimaryResident ? "Primary Resident" : "Co-resident")</div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header">👥 Co-residents</div>
        <div class="card-ss-body p-0">
          @if (cores.Count == 0) {
            <div class="empty-state"><div class="icon-lg">👤</div><h5>Only you</h5><p>No other residents registered for this flat.</p></div>
          } else {
            <table class="table-ss">
              <thead><tr><th>Name</th><th>Relationship</th><th>Primary</th></tr></thead>
              <tbody>
              @foreach (var r in cores) {
                <tr>
                  <td><strong>@r.User.Name</strong><div class="small text-muted">@r.User.Phone</div></td>
                  <td>@r.Relationship</td>
                  <td>@(r.IsPrimaryResident ? "Yes" : "—")</td>
                </tr>
              }
              </tbody>
            </table>
          }
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header">
          <span>🚗 My Vehicles</span>
          <a href="/Vehicles/Mine" class="btn btn-sm btn-outline-secondary">Manage</a>
        </div>
        <div class="card-ss-body p-0">
          @if (vehicles.Count == 0) {
            <div class="empty-state"><div class="icon-lg">🚗</div><h5>No vehicles</h5><p>Register a vehicle from the Vehicles page.</p></div>
          } else {
            <table class="table-ss">
              <thead><tr><th>Reg. No</th><th>Type</th><th>Model</th></tr></thead>
              <tbody>
              @foreach (var v in vehicles) {
                <tr>
                  <td><strong>@v.RegistrationNumber</strong></td>
                  <td>@v.Type</td>
                  <td>@v.Model</td>
                </tr>
              }
              </tbody>
            </table>
          }
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header">🅿️ Parking Slots</div>
        <div class="card-ss-body p-0">
          @if (parking.Count == 0) {
            <div class="empty-state"><div class="icon-lg">🅿️</div><h5>No slot assigned</h5><p>Contact admin to assign a parking slot.</p></div>
          } else {
            <table class="table-ss">
              <thead><tr><th>Slot</th><th>Type</th><th>Vehicle</th></tr></thead>
              <tbody>
              @foreach (var s in parking) {
                <tr>
                  <td><strong>@s.SlotNumber</strong></td>
                  <td>@s.Type</td>
                  <td>@s.VehicleNumber</td>
                </tr>
              }
              </tbody>
            </table>
          }
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header">
          <span>🧾 Recent Bills</span>
          <a href="/Bills" class="btn btn-sm btn-outline-secondary">All Bills</a>
        </div>
        <div class="card-ss-body p-0">
          @if (bills.Count == 0) {
            <div class="empty-state"><div class="icon-lg">🧾</div><h5>No bills yet</h5><p>Maintenance bills will appear here.</p></div>
          } else {
            <table class="table-ss">
              <thead><tr><th>Month</th><th>Amount</th><th>Status</th></tr></thead>
              <tbody>
              @foreach (var b in bills) {
                <tr>
                  <td><strong>@b.BillingMonth</strong></td>
                  <td>₹@b.TotalAmount.ToString("N0")</td>
                  <td><span class="badge bg-@(b.Status == SocioSphere.Core.Enums.BillStatus.PAID ? "success" : b.Status == SocioSphere.Core.Enums.BillStatus.OVERDUE ? "danger" : "warning text-dark")">@b.Status</span></td>
                </tr>
              }
              </tbody>
            </table>
          }
        </div>
      </div>
    </div>
  </div>
}