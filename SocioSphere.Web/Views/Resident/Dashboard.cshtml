@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_ResidentLayout";
    var profile = ViewBag.Profile as SocioSphere.Core.Entities.ResidentProfile;
    var currentBill = ViewBag.CurrentBill as SocioSphere.Core.Entities.MaintenanceBill;
    var lastPayment = ViewBag.LastPayment as SocioSphere.Core.Entities.Payment;
    var upcomingBookings = ViewBag.UpcomingBookings as List<SocioSphere.Core.Entities.AmenityBooking>;
    var notices = ViewBag.Notices as List<SocioSphere.Core.Entities.Notice>;
    var openComplaints = ViewBag.OpenComplaints as List<SocioSphere.Core.Entities.Complaint>;
    var outstanding = (decimal)(ViewBag.Outstanding ?? 0m);

    decimal paidAmount = 0m;
    int paidPct = 0;
    if (currentBill != null)
    {
        paidAmount = currentBill.TotalAmount - outstanding;
        if (paidAmount < 0) paidAmount = 0;
        paidPct = currentBill.TotalAmount > 0 ? (int)(paidAmount * 100 / currentBill.TotalAmount) : 0;
        if (paidPct > 100) paidPct = 100;
    }
}
<div class="welcome-banner">
  <div>
    <h2>Welcome back, @ViewBag.UserName</h2>
    <p>Here's what's happening with your home today</p>
  </div>
  <div class="avatar">@(ViewBag.UserName?.ToString()?.Substring(0,1).ToUpper() ?? "R")</div>
</div>

@if (profile == null) {
  <div class="card-ss">
    <div class="card-ss-body empty-state">
      <div class="icon-lg">🏠</div>
      <h5>No flat linked</h5>
      <p>Your account is not linked to a flat yet. Please contact the society admin.</p>
    </div>
  </div>
} else {
  <div class="stat-grid">
    <div class="stat-card">
      <span class="icon">🏠</span>
      <div class="label">My Flat</div>
      <div class="value">@profile.Flat.FlatNumber</div>
      <div class="meta">Building @profile.Flat.Building.Name · @profile.Flat.FlatType</div>
    </div>
    <div class="stat-card @(outstanding > 0 ? "danger" : "accent")">
      <span class="icon">💰</span>
      <div class="label">Outstanding</div>
      <div class="value">₹@outstanding.ToString("N0")</div>
      <div class="meta">@(outstanding > 0 ? "Payment due" : "All clear")</div>
    </div>
    <div class="stat-card @((openComplaints?.Count ?? 0) > 0 ? "warn" : "accent")">
      <span class="icon">🛠️</span>
      <div class="label">Open Complaints</div>
      <div class="value">@(openComplaints?.Count ?? 0)</div>
      <div class="meta">Active service requests</div>
    </div>
    <div class="stat-card info">
      <span class="icon">📅</span>
      <div class="label">Bookings</div>
      <div class="value">@(upcomingBookings?.Count ?? 0)</div>
      <div class="meta">Upcoming reservations</div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header"><span>🧾 Current Bill</span></div>
        <div class="card-ss-body">
          @if (currentBill == null) {
            <div class="empty-state"><div class="icon-lg">🧾</div><h5>No bills yet</h5><p>No maintenance bills have been generated for your flat.</p></div>
          } else {
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <div class="text-muted small">Billing Month</div>
                <div style="font-size:1.4rem;font-weight:700;color:var(--navy);">@currentBill.BillingMonth</div>
              </div>
              <div class="text-end">
                <div class="text-muted small">Total</div>
                <div style="font-size:1.4rem;font-weight:700;color:var(--navy);">₹@currentBill.TotalAmount.ToString("N0")</div>
              </div>
            </div>
            <div class="d-flex justify-content-between small mb-2">
              <span class="text-muted">Due Date: @currentBill.DueDate.ToString("dd MMM yyyy")</span>
              <span class="badge bg-@(currentBill.Status == SocioSphere.Core.Enums.BillStatus.PAID ? "success" : currentBill.Status == SocioSphere.Core.Enums.BillStatus.OVERDUE ? "danger" : "warning text-dark")">@currentBill.Status</span>
            </div>
            <div class="progress-ss mb-1"><div class="bar" style="width:@paidPct%"></div></div>
            <div class="small text-muted">₹@paidAmount.ToString("N0") paid of ₹@currentBill.TotalAmount.ToString("N0")</div>
          }
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header"><span>💳 Last Payment</span></div>
        <div class="card-ss-body">
          @if (lastPayment == null) {
            <div class="empty-state"><div class="icon-lg">💳</div><h5>No payments yet</h5><p>Once you record a payment it will appear here.</p></div>
          } else {
            <div class="d-flex justify-content-between mb-2"><span class="text-muted">Amount</span><strong style="color:var(--accent-dark);font-size:1.15rem;">₹@lastPayment.Amount.ToString("N0")</strong></div>
            <div class="d-flex justify-content-between mb-2"><span class="text-muted">Method</span><span>@lastPayment.Method</span></div>
            <div class="d-flex justify-content-between mb-2"><span class="text-muted">Date</span><span>@lastPayment.PaymentDate.ToString("dd MMM yyyy")</span></div>
            <div class="d-flex justify-content-between"><span class="text-muted">Status</span><span class="badge bg-success">@lastPayment.Status</span></div>
          }
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header">
          <span>📅 Upcoming Bookings</span>
          <a href="/Amenities" class="btn btn-sm btn-outline-secondary">Book</a>
        </div>
        <div class="card-ss-body p-0">
          @if (upcomingBookings == null || upcomingBookings.Count == 0) {
            <div class="empty-state"><div class="icon-lg">📅</div><h5>No upcoming bookings</h5><p>Book an amenity to see it here.</p></div>
          } else {
            <table class="table-ss">
              <thead><tr><th>Amenity</th><th>Date</th><th>Time</th></tr></thead>
              <tbody>
              @foreach (var b in upcomingBookings) {
                <tr>
                  <td><strong>@b.Amenity.Name</strong></td>
                  <td>@b.BookingDate.ToString("dd MMM")</td>
                  <td>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</td>
                </tr>
              }
              </tbody>
            </table>
          }
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card-ss">
        <div class="card-ss-header">
          <span>📢 Society Notices</span>
          <a href="/Notices/Active" class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
        <div class="card-ss-body p-0">
          @if (notices == null || notices.Count == 0) {
            <div class="empty-state"><div class="icon-lg">📢</div><h5>No active notices</h5><p>The society hasn't posted any notices.</p></div>
          } else {
            @foreach (var n in notices) {
              <div class="px-4 py-3 border-bottom" style="border-color: var(--gray-border) !important;">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <strong>@n.Title</strong>
                    <div class="small text-muted mt-1">@n.Category · @n.PublishedAt.ToString("dd MMM yyyy")</div>
                  </div>
                  <span class="badge bg-@(n.Priority == SocioSphere.Core.Enums.NoticePriority.URGENT ? "danger" : n.Priority == SocioSphere.Core.Enums.NoticePriority.HIGH ? "warning text-dark" : "secondary")">@n.Priority</span>
                </div>
              </div>
            }
          }
        </div>
      </div>
    </div>
  </div>
}