@model SocioSphere.Core.Entities.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    string layout = User.IsInRole("Admin") ? "_AdminLayout"
                  : User.IsInRole("Resident") ? "_ResidentLayout"
                  : User.IsInRole("Security") ? "_SecurityLayout" : "_Layout";
    Layout = layout;
    var role = (ViewBag.Roles as IList<string>)?.FirstOrDefault() ?? "User";
}
<h1 class="page-title">My Profile</h1>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row g-3">
  <div class="col-lg-4">
    <div class="card-ss">
      <div class="card-ss-body text-center" style="padding:2rem 1.25rem;">
        <div style="width:72px;height:72px;font-size:2rem;margin:0 auto 1rem;background:linear-gradient(135deg,var(--accent),var(--accent-dark));color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;">@Model.Name.Substring(0,1).ToUpper()</div>
        <h4 style="margin:0;color:var(--navy);font-weight:600;">@Model.Name</h4>
        <div class="text-muted small mt-1">@Model.Email</div>
        <span class="badge bg-@(role == "Admin" ? "primary" : role == "Security" ? "danger" : "success") mt-3">@role</span>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card-ss mb-3">
      <div class="card-ss-header">Account Information</div>
      <div class="card-ss-body">
        <form method="post" action="/Profile/Update">
          @Html.AntiForgeryToken()
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Full Name</label>
              <input name="name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input value="@Model.Email" class="form-control" disabled />
            </div>
            <div class="col-md-6">
              <label class="form-label">Phone</label>
              <input name="phone" value="@Model.Phone" class="form-control" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Member Since</label>
              <input value="@Model.CreatedAt.ToString("dd MMM yyyy")" class="form-control" disabled />
            </div>
          </div>
          <div class="mt-3"><button class="btn btn-accent">Save Changes</button></div>
        </form>
      </div>
    </div>

    @if (ViewBag.FlatNumber != null) {
      <div class="card-ss mb-3">
        <div class="card-ss-header">Flat Details</div>
        <div class="card-ss-body">
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Flat</span><strong>@ViewBag.FlatNumber</strong></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Building</span><span>@ViewBag.BuildingName</span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Relationship</span><span>@ViewBag.Relationship</span></div>
          <div class="d-flex justify-content-between"><span class="text-muted">Primary Resident</span><span>@(ViewBag.IsPrimary == true ? "Yes" : "No")</span></div>
        </div>
      </div>
    }

    <div class="card-ss">
      <div class="card-ss-header">Change Password</div>
      <div class="card-ss-body">
        <form method="post" action="/Profile/ChangePassword">
          @Html.AntiForgeryToken()
          <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Current Password</label><input type="password" name="currentPassword" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label">New Password</label><input type="password" name="newPassword" class="form-control" required minlength="8" /></div>
            <div class="col-md-4"><label class="form-label">Confirm New</label><input type="password" name="confirmPassword" class="form-control" required minlength="8" /></div>
          </div>
          <div class="mt-3"><button class="btn btn-outline-secondary">Change Password</button></div>
        </form>
      </div>
    </div>
  </div>
</div>