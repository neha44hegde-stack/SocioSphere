@{
    ViewData["Title"] = "Society Expenses";
    Layout = "_AdminLayout";
    var list = Model as List<SocioSphere.Core.Entities.SocietyExpense>;
    var vendors = ViewBag.Vendors as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var total = (decimal)ViewBag.Total;
}
<h1 class="page-title">Society Expenses</h1>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="stat-card mb-3"><div class="label">Total (filtered)</div><div class="value danger">₹@total.ToString("N0")</div></div>
<div class="card-ss mb-3">
  <div class="card-ss-header">Record Expense</div>
  <div class="card-ss-body">
    <form method="post" action="/Expenses/Create" class="row g-2">
      @Html.AntiForgeryToken()
      <div class="col-md-3"><input name="name" class="form-control" placeholder="Expense name" required /></div>
      <div class="col-md-2"><select name="category" class="form-select">@foreach (var c in Enum.GetValues<SocioSphere.Core.Enums.ExpenseCategory>()) { <option value="@c">@c</option> }</select></div>
      <div class="col-md-2"><input type="number" step="0.01" name="amount" class="form-control" placeholder="Amount ₹" required /></div>
      <div class="col-md-2"><input type="date" name="expenseDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
      <div class="col-md-2"><select name="vendorId" class="form-select" asp-items="vendors"><option value="">— Vendor —</option></select></div>
      <div class="col-md-12 mt-2"><input name="description" class="form-control" placeholder="Description" /></div>
      <div class="col-md-12 mt-2"><button class="btn btn-accent">Record</button></div>
    </form>
  </div>
</div>
<div class="card-ss"><div class="card-ss-body p-0">
  @if (list == null || list.Count == 0) { <div class="empty-state">No expenses recorded.</div> }
  else {
    <table class="table table-ss mb-0"><thead><tr><th>Date</th><th>Name</th><th>Category</th><th>Amount</th><th>Vendor</th></tr></thead><tbody>
    @foreach (var e in list) {
      <tr><td>@e.ExpenseDate.ToString("dd MMM yyyy")</td><td>@e.Name</td><td>@e.Category</td><td>₹@e.Amount.ToString("N0")</td><td>@e.Vendor?.Name</td></tr>
    }
    </tbody></table>
  }
</div></div>