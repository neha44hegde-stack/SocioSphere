@{
    ViewData["Title"] = "Notices";
    Layout = "_AdminLayout";
    var list = Model as List<SocioSphere.Core.Entities.Notice>;
    var now = DateTime.UtcNow;
}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="page-title mb-0">Notices</h1>
  <a href="/Notices/Create" class="btn btn-accent">+ New Notice</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<form method="get" class="row g-2 mb-3">
  <div class="col-md-3">
    <select name="category" class="form-select">
      <option value="">— All Categories —</option>
      @foreach (var c in Enum.GetValues<SocioSphere.Core.Enums.NoticeCategory>())
      { <option value="@c" selected="@(ViewBag.Category?.ToString() == c.ToString())">@c</option> }
    </select>
  </div>
  <div class="col-md-3"><button class="btn btn-outline-secondary w-100">Filter</button></div>
</form>

<div class="card-ss">
  <div class="card-ss-body p-0">
    @if (list == null || list.Count == 0) {
      <div class="empty-state">No notices published.</div>
    } else {
      <table class="table table-ss mb-0">
        <thead><tr><th>Title</th><th>Category</th><th>Priority</th><th>Published</th><th>Expires</th><th>State</th><th></th></tr></thead>
        <tbody>
        @foreach (var n in list) {
          var expired = n.ExpiresAt.HasValue && n.ExpiresAt < now;
          <tr>
            <td><strong>@n.Title</strong></td>
            <td>@n.Category</td>
            <td>
              <span class="badge bg-@(n.Priority == SocioSphere.Core.Enums.NoticePriority.URGENT ? "danger"
                  : n.Priority == SocioSphere.Core.Enums.NoticePriority.HIGH ? "warning text-dark" : "secondary")">@n.Priority</span>
            </td>
            <td>@n.PublishedAt.ToString("dd MMM yyyy")</td>
            <td>@(n.ExpiresAt?.ToString("dd MMM yyyy") ?? "—")</td>
            <td>@(expired ? "Expired" : "Active")</td>
            <td class="text-end">
              <a href="/Notices/Details/@n.Id" class="btn btn-sm btn-outline-secondary">View</a>
              <a href="/Notices/Edit/@n.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
              <form method="post" action="/Notices/Delete" class="d-inline" onsubmit="return confirm('Delete this notice?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@n.Id" />
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    }
  </div>
</div>