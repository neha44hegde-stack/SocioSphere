<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - SocioSphere</title>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/sociosphere.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-ss px-3 d-flex">
  <a class="navbar-brand" href="/"><span>●</span> SocioSphere</a>
  <div class="ms-auto d-flex align-items-center">
    @if (User.Identity?.IsAuthenticated == true)
    {
      <span class="text-light me-3 small">@User.Identity.Name</span>
      <form method="post" action="/Identity/Account/Logout" class="d-inline">
        @Html.AntiForgeryToken()
        <button class="btn btn-sm btn-outline-light">Logout</button>
      </form>
    }
    else
    {
      <a class="btn btn-sm btn-outline-light me-2" href="/Identity/Account/Login">Login</a>
      <a class="btn btn-sm btn-accent" href="/Identity/Account/Register">Register</a>
    }
  </div>
</nav>
<main>
  @RenderBody()
</main>
<footer class="footer-ss">
  <div class="container small">
    © @DateTime.UtcNow.Year · SocioSphere — Housing Society Management
  </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>