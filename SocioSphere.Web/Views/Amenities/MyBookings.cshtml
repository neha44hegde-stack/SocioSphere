@{
    ViewData["Title"] = "My Bookings";
    Layout = "_ResidentLayout";
    var list = Model as List<SocioSphere.Core.Entities.AmenityBooking>;
}
<h1 class="page-title">My Bookings</h1>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<div class="card-ss">
  <div class="card-ss-body p-0">
    @if (list == null || list.Count == 0) {
      <div class="empty-state">No bookings yet.</div>
    } else {
      <table class="table table-ss mb-0">
        <thead><tr><th>Amenity</th><th>Date</th><th>Time</th><th>Purpose</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in list) {
          <tr>
            <td>@b.Amenity.Name</td>
            <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
            <td>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</td>
            <td>@b.Purpose</td>
            <td><span class="badge bg-@(b.Status == SocioSphere.Core.Enums.BookingStatus.CONFIRMED ? "success" : b.Status == SocioSphere.Core.Enums.BookingStatus.CANCELLED ? "secondary" : "info")">@b.Status</span></td>
            <td class="text-end">
              @if (b.Status == SocioSphere.Core.Enums.BookingStatus.CONFIRMED) {
                <form method="post" action="/Amenities/Cancel" class="d-inline" onsubmit="return confirm('Cancel?');">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@b.Id" />
                  <button class="btn btn-sm btn-outline-danger">Cancel</button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    }
  </div>
</div>