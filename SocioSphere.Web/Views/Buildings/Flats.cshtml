@{
    ViewData["Title"] = "Flats";
    Layout = "_AdminLayout";
    var b = Model as SocioSphere.Core.Entities.Building;
}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="page-title mb-0">Building @b.Name — Flats</h1>
  <a href="/Buildings" class="btn btn-outline-secondary">← Buildings</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card-ss mb-3">
  <div class="card-ss-header">Add Flat</div>
  <div class="card-ss-body">
    <form method="post" action="/Buildings/AddFlat" class="row g-2">
      @Html.AntiForgeryToken()
      <input type="hidden" name="buildingId" value="@b.Id" />
      <div class="col-md-3"><input name="flatNumber" class="form-control" placeholder="Flat e.g. A-301" required /></div>
      <div class="col-md-2"><input type="number" name="floor" class="form-control" placeholder="Floor" /></div>
      <div class="col-md-3"><input name="flatType" class="form-control" placeholder="Type e.g. 2BHK" /></div>
      <div class="col-md-2"><input type="number" step="0.01" name="area" class="form-control" placeholder="Area" /></div>
      <div class="col-md-2"><button class="btn btn-accent w-100">Add</button></div>
    </form>
  </div>
</div>
<div class="card-ss">
  <div class="card-ss-body p-0">
    @if (b.Flats.Count == 0) { <div class="empty-state">No flats in this building.</div> }
    else {
      <table class="table table-ss mb-0">
        <thead><tr><th>Flat</th><th>Floor</th><th>Type</th><th>Area</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in b.Flats.OrderBy(x => x.FlatNumber)) {
          <tr>
            <td><strong>@f.FlatNumber</strong></td><td>@f.Floor</td><td>@f.FlatType</td><td>@f.Area sqft</td>
            <td><span class="badge bg-@(f.Status == SocioSphere.Core.Enums.FlatStatus.OCCUPIED ? "success" : "secondary")">@f.Status</span></td>
            <td class="text-end">
              <form method="post" action="/Buildings/DeleteFlat" class="d-inline" onsubmit="return confirm('Delete flat?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@f.Id" />
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
      </table>
    }
  </div>
</div>