@{
    ViewData["Title"] = "Buildings";
    Layout = "_AdminLayout";
    var list = Model as List<SocioSphere.Core.Entities.Building>;
}
<h1 class="page-title">Buildings & Flats</h1>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card-ss mb-3">
  <div class="card-ss-header">Add Building</div>
  <div class="card-ss-body">
    <form method="post" action="/Buildings/Create" class="row g-2">
      @Html.AntiForgeryToken()
      <div class="col-md-5"><input name="name" class="form-control" placeholder="Building name e.g. C" required /></div>
      <div class="col-md-4"><input type="number" name="totalFloors" class="form-control" placeholder="Total floors" value="4" /></div>
      <div class="col-md-3"><button class="btn btn-accent w-100">Add Building</button></div>
    </form>
  </div>
</div>
@if (list == null || list.Count == 0) { <div class="card-ss"><div class="card-ss-body empty-state">No buildings yet.</div></div> }
else {
  <div class="row g-3">
  @foreach (var b in list) {
    <div class="col-md-4">
      <div class="card-ss h-100">
        <div class="card-ss-header d-flex justify-content-between">
          <span>Building @b.Name</span>
          <span class="badge bg-secondary">@b.Flats.Count flats</span>
        </div>
        <div class="card-ss-body">
          <div><strong>Floors:</strong> @b.TotalFloors</div>
          <div><strong>Occupied:</strong> @b.Flats.Count(f => f.Status == SocioSphere.Core.Enums.FlatStatus.OCCUPIED)</div>
          <div class="mt-3"><a href="/Buildings/Flats/@b.Id" class="btn btn-sm btn-accent">Manage Flats</a></div>
        </div>
      </div>
    </div>
  }
  </div>
}