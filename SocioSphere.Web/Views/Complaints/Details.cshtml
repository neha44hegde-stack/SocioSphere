@{
    ViewData["Title"] = "Complaint Details";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_ResidentLayout";
    var c = Model as SocioSphere.Core.Entities.Complaint;
    var staff = ViewBag.Staff as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var statuses = ViewBag.Statuses as Array;
    var isAdmin = User.IsInRole("Admin");
}
<h1 class="page-title">@c.Title</h1>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="row g-3">
  <div class="col-md-7">
    <div class="card-ss">
      <div class="card-ss-header">Details</div>
      <div class="card-ss-body">
        <div class="d-flex justify-content-between mb-2"><span>Flat</span><strong>@c.Flat?.FlatNumber</strong></div>
        <div class="d-flex justify-content-between mb-2"><span>Category</span><span>@c.Category</span></div>
        <div class="d-flex justify-content-between mb-2"><span>Priority</span><span class="badge bg-secondary">@c.Priority</span></div>
        <div class="d-flex justify-content-between mb-2"><span>Status</span><span class="badge bg-secondary">@c.Status</span></div>
        <div class="d-flex justify-content-between mb-2"><span>Raised by</span><span>@c.RaisedBy?.Name</span></div>
        <div class="d-flex justify-content-between mb-2"><span>Raised on</span><span>@c.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</span></div>
        @if (c.ResolvedAt.HasValue) {
          <div class="d-flex justify-content-between mb-2"><span>Resolved on</span><span>@c.ResolvedAt.Value.ToString("dd MMM yyyy hh:mm tt")</span></div>
        }
        <hr />
        <div style="white-space:pre-wrap;">@c.Description</div>
        @if (!string.IsNullOrEmpty(c.ResolutionNotes)) {
          <hr />
          <div><strong>Resolution:</strong></div>
          <div style="white-space:pre-wrap;">@c.ResolutionNotes</div>
        }
      </div>
    </div>
  </div>

  <div class="col-md-5">
    @if (isAdmin) {
      <div class="card-ss mb-3">
        <div class="card-ss-header">Manage (Admin)</div>
        <div class="card-ss-body">
          <form method="post" action="/Complaints/Assign" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@c.Id" />
            <label class="form-label">Assign Staff</label>
            <select name="staffId" class="form-select mb-2" asp-items="staff"><option value="">— Unassigned —</option></select>
            <label class="form-label">Status</label>
            <select name="status" class="form-select mb-2">
              @foreach (var s in Enum.GetValues<SocioSphere.Core.Enums.ComplaintStatus>())
              { <option value="@s" selected="@(c.Status == s)">@s</option> }
            </select>
            <button class="btn btn-accent w-100">Update</button>
          </form>

          <form method="post" action="/Complaints/Resolve">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@c.Id" />
            <label class="form-label">Resolution Notes</label>
            <textarea name="resolutionNotes" rows="3" class="form-control mb-2">@c.ResolutionNotes</textarea>
            <button class="btn btn-success w-100">Mark Resolved</button>
          </form>

          @if (c.Status != SocioSphere.Core.Enums.ComplaintStatus.CLOSED) {
            <form method="post" action="/Complaints/Close" class="mt-2">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@c.Id" />
              <button class="btn btn-outline-secondary w-100">Close Complaint</button>
            </form>
          }
        </div>
      </div>
    } else {
      @if (c.Status != SocioSphere.Core.Enums.ComplaintStatus.CLOSED && c.Status != SocioSphere.Core.Enums.ComplaintStatus.RESOLVED) {
        <div class="card-ss">
          <div class="card-ss-header">Add Information</div>
          <div class="card-ss-body">
            <form method="post" action="/Complaints/AddInfo">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@c.Id" />
              <textarea name="note" rows="4" class="form-control mb-2" placeholder="Add more details…" required></textarea>
              <button class="btn btn-accent">Submit</button>
            </form>
          </div>
        </div>
      }
    }
  </div>
</div>

<div class="mt-3">
  <a href="@(isAdmin ? "/Complaints" : "/Complaints/MyComplaints")" class="btn btn-outline-secondary">← Back</a>
</div>