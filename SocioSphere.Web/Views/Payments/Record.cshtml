@{
    ViewData["Title"] = "Record Payment";
    Layout = "_AdminLayout";
    var bill = ViewBag.Bill as SocioSphere.Core.Entities.MaintenanceBill;
    var outstanding = (decimal)ViewBag.Outstanding;
}
<h1 class="page-title">Record Payment</h1>

<div class="row g-3">
  <div class="col-md-5">
    <div class="card-ss">
      <div class="card-ss-header">Bill Reference</div>
      <div class="card-ss-body">
        <div class="d-flex justify-content-between"><span>Flat</span><strong>@bill.Flat.FlatNumber</strong></div>
        <div class="d-flex justify-content-between"><span>Month</span><span>@bill.BillingMonth</span></div>
        <div class="d-flex justify-content-between"><span>Total</span><span>₹@bill.TotalAmount.ToString("N0")</span></div>
        <div class="d-flex justify-content-between"><span>Paid</span><span>₹@(((decimal)ViewBag.Paid).ToString("N0"))</span></div>
        <hr />
        <div class="d-flex justify-content-between"><strong>Outstanding</strong><strong class="text-danger">₹@outstanding.ToString("N0")</strong></div>
      </div>
    </div>
  </div>

  <div class="col-md-7">
    <form method="post" class="card-ss p-4">
      @Html.AntiForgeryToken()
      <input type="hidden" name="MaintenanceBillId" value="@bill.Id" />
      <div asp-validation-summary="All" class="text-danger mb-2"></div>

      <div class="mb-3">
        <label class="form-label">Amount ₹</label>
        <input type="number" step="0.01" name="Amount" value="@Model.Amount" max="@outstanding" class="form-control" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Method</label>
        <select name="Method" class="form-select">
          @foreach (var m in Enum.GetValues<SocioSphere.Core.Enums.PaymentMethod>())
          { <option value="@m">@m</option> }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Transaction Reference</label>
        <input type="text" name="TransactionReference" value="@Model.TransactionReference" class="form-control" placeholder="UPI / cheque no / bank ref" />
      </div>
      <div class="mb-3">
        <label class="form-label">Status</label>
        <select name="Status" class="form-select">
          @foreach (var s in Enum.GetValues<SocioSphere.Core.Enums.PaymentStatus>())
          { <option value="@s" selected="@(s == SocioSphere.Core.Enums.PaymentStatus.SUCCESS)">@s</option> }
        </select>
      </div>

      <button class="btn btn-accent">Save Payment</button>
      <a href="/Bills" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
