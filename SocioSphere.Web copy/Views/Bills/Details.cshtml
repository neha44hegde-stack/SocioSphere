@{
    ViewData["Title"] = "Bill Details";
    Layout = "_AdminLayout";
    var b = Model as SocioSphere.Core.Entities.MaintenanceBill;
}
<h1 class="page-title">Bill · @b.Flat.FlatNumber · @b.BillingMonth</h1>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card-ss">
      <div class="card-ss-header">Bill Summary</div>
      <div class="card-ss-body">
        <div class="d-flex justify-content-between"><span>Base</span><span>₹@b.BaseMaintenance.ToString("N0")</span></div>
        <div class="d-flex justify-content-between"><span>Water</span><span>₹@b.WaterCharge.ToString("N0")</span></div>
        <div class="d-flex justify-content-between"><span>Parking</span><span>₹@b.ParkingCharge.ToString("N0")</span></div>
        <div class="d-flex justify-content-between"><span>Other</span><span>₹@b.OtherCharge.ToString("N0")</span></div>
        <div class="d-flex justify-content-between"><span>Late Fee</span><span>₹@b.LateFee.ToString("N0")</span></div>
        <hr />
        <div class="d-flex justify-content-between"><strong>Total</strong><strong>₹@b.TotalAmount.ToString("N0")</strong></div>
        <div class="d-flex justify-content-between"><span>Paid</span><span>₹@(((decimal)ViewBag.Paid).ToString("N0"))</span></div>
        <div class="d-flex justify-content-between"><span>Outstanding</span><span class="text-danger">₹@(((decimal)ViewBag.Outstanding).ToString("N0"))</span></div>
        <div class="d-flex justify-content-between mt-2"><span>Due</span><span>@b.DueDate.ToString("dd MMM yyyy")</span></div>
        <div class="d-flex justify-content-between"><span>Status</span><span class="badge bg-secondary">@b.Status</span></div>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card-ss">
      <div class="card-ss-header d-flex justify-content-between">
        <span>Payments</span>
        <a href="/Payments/Record?billId=@b.Id" class="btn btn-sm btn-accent">+ Record Payment</a>
      </div>
      <div class="card-ss-body p-0">
        @if (b.Payments.Count == 0) {
          <div class="empty-state">No payments recorded yet.</div>
        } else {
          <table class="table table-sm table-ss mb-0"><thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Ref</th></tr></thead><tbody>
          @foreach (var p in b.Payments.OrderByDescending(x => x.PaymentDate)) {
            <tr><td>@p.PaymentDate.ToString("dd MMM yyyy")</td><td>₹@p.Amount.ToString("N0")</td><td>@p.Method</td><td>@p.TransactionReference</td></tr>
          }
          </tbody></table>
        }
      </div>
    </div>
  </div>
</div>

<div class="mt-3">
  <a href="/Bills" class="btn btn-outline-secondary">← Back to Bills</a>
</div>