@{
    ViewData["Title"] = "New Bill";
    Layout = "_AdminLayout";
    var flats = ViewBag.Flats as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}
<h1 class="page-title">Create Maintenance Bill</h1>

<form method="post" class="card-ss p-4" style="max-width:720px;">
  @Html.AntiForgeryToken()
  <div asp-validation-summary="All" class="text-danger mb-2"></div>

  <div class="mb-3">
    <label class="form-label">Flat</label>
    <select name="FlatId" class="form-select" asp-items="flats"><option value="">— Select Flat —</option></select>
  </div>

  <div class="mb-3">
    <label class="form-label">Billing Month</label>
    <input type="month" name="BillingMonth" value="@Model.BillingMonth" class="form-control" required />
  </div>

  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Base Maintenance ₹</label><input type="number" step="0.01" name="BaseMaintenance" value="@Model.BaseMaintenance" class="form-control" required /></div>
    <div class="col-md-6"><label class="form-label">Water Charge ₹</label><input type="number" step="0.01" name="WaterCharge" value="@Model.WaterCharge" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Parking Charge ₹</label><input type="number" step="0.01" name="ParkingCharge" value="@Model.ParkingCharge" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Other Charge ₹</label><input type="number" step="0.01" name="OtherCharge" value="@Model.OtherCharge" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Late Fee ₹</label><input type="number" step="0.01" name="LateFee" value="@Model.LateFee" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Due Date</label><input type="date" name="DueDate" value="@Model.DueDate.ToString("yyyy-MM-dd")" class="form-control" required /></div>
  </div>

  <div class="mt-4">
    <button class="btn btn-accent">Create Bill</button>
    <a href="/Bills" class="btn btn-outline-secondary ms-2">Cancel</a>
  </div>
</form>