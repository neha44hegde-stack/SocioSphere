@{
    ViewData["Title"] = "Generate Monthly Bills";
    Layout = "_AdminLayout";
}
<h1 class="page-title">Generate Monthly Maintenance Bills</h1>
<p class="text-muted">Bills will be created for every <strong>OCCUPIED</strong> flat. Flats with an existing bill for the same month are skipped automatically.</p>

<form method="post" class="card-ss p-4" style="max-width:720px;">
  @Html.AntiForgeryToken()
  <div class="mb-3">
    <label class="form-label">Billing Month</label>
    <input type="month" name="billingMonth" value="@DateTime.UtcNow.ToString("yyyy-MM")" class="form-control" required />
  </div>

  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Base Maintenance ₹</label><input type="number" step="0.01" name="baseAmt" value="2000" class="form-control" required /></div>
    <div class="col-md-6"><label class="form-label">Water Charge ₹</label><input type="number" step="0.01" name="water" value="300" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Parking Charge ₹</label><input type="number" step="0.01" name="parking" value="500" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Other Charge ₹</label><input type="number" step="0.01" name="other" value="0" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Due in (days)</label><input type="number" name="dueDays" value="15" class="form-control" /></div>
  </div>

  <div class="mt-4">
    <button class="btn btn-accent">Generate</button>
    <a href="/Bills" class="btn btn-outline-secondary ms-2">Cancel</a>
  </div>
</form>